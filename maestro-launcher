#!/bin/bash

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Function to show usage
show_usage() {
    cat << 'EOF'
🎼 Maestro Launcher - macOS App Manager

Usage:
    ./maestro-launcher --install     Install MaestroDev.app to your Desktop
    ./maestro-launcher --uninstall   Remove MaestroDev.app from your Desktop
    ./maestro-launcher --update      Update existing MaestroDev.app installation
    ./maestro-launcher --help        Show this help message

Configuration:
    Edit config.sh to configure your worktree path and settings.
    Copy config-example.sh to config.sh if it doesn't exist yet.

EOF
    exit 0
}

# Function to load and validate config
load_config() {
    if [[ ! -f "$SCRIPT_DIR/config.sh" ]]; then
        echo "❌ Error: config.sh not found."
        echo ""
        echo "Please create config.sh first:"
        echo "  cp config-example.sh config.sh"
        echo "  # Edit config.sh with your settings"
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/config.sh"

    # Validate that MAESTRO_WORKTREE_DIR is set
    if [[ -z "$MAESTRO_WORKTREE_DIR" ]]; then
        echo "❌ Error: MAESTRO_WORKTREE_DIR is not set in config.sh"
        exit 1
    fi
}

# Function to validate worktree
validate_worktree() {
    # Check if the worktree directory exists
    if [[ ! -d "$MAESTRO_WORKTREE_DIR" ]]; then
        echo "⚠️  Warning: Maestro worktree directory does not exist: $MAESTRO_WORKTREE_DIR"
        echo "   The launcher will be created, but it won't work until this directory exists."
        echo ""
    fi

    # Check if worktree is actually a git worktree
    if [[ -d "$MAESTRO_WORKTREE_DIR/.git" ]]; then
        if ! grep -q "gitdir:" "$MAESTRO_WORKTREE_DIR/.git" 2>/dev/null; then
            echo "⚠️  Warning: $MAESTRO_WORKTREE_DIR appears to be a regular git repo, not a worktree."
            echo ""
        fi
    fi
}

# Inject LaunchServices architecture keys into the installed bundle's
# Info.plist so launchd starts launch.sh under the host's NATIVE cpu type.
#
# This bundle's CFBundleExecutable is a shell script, so launchd runs the
# universal /bin/bash interpreter. With no arch hint, on Apple Silicon it can
# pick the x86_64 slice — and that x86_64 cpu-type preference is then inherited
# by every child (npm, node, Electron, the agent shell, and any cmake/clang it
# spawns), silently producing x86_64 builds on an arm64 machine. Declaring an
# arm64-first LSArchitecturePriority (+ LSRequiresNativeExecution) makes the
# whole process tree native. Gated on the HARDWARE flag (hw.optional.arm64),
# not the possibly-translated shell, so it is a no-op on real Intel hosts.
configure_app_architecture() {
    local plist="$DESKTOP_APP_PATH/Contents/Info.plist"
    local pb="/usr/libexec/PlistBuddy"

    if [[ ! -f "$plist" ]]; then
        echo "⚠️  Skipping architecture config: $plist not found"
        return 0
    fi
    if [[ ! -x "$pb" ]]; then
        echo "⚠️  Skipping architecture config: PlistBuddy not available"
        return 0
    fi

    # Idempotent: clear any prior keys before (re)writing so --update doesn't
    # accumulate or conflict.
    "$pb" -c "Delete :LSArchitecturePriority" "$plist" 2>/dev/null || true
    "$pb" -c "Delete :LSRequiresNativeExecution" "$plist" 2>/dev/null || true

    if [[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" == "1" ]]; then
        echo "   Configuring native arm64 launch (Apple Silicon)..."
        # arm64e first: /bin/bash (launch.sh's interpreter) is [x86_64 arm64e],
        # with no plain arm64 slice. arm64 is listed for other universal
        # children; x86_64 last as a fallback.
        "$pb" -c "Add :LSArchitecturePriority array" "$plist"
        "$pb" -c "Add :LSArchitecturePriority:0 string arm64e" "$plist"
        "$pb" -c "Add :LSArchitecturePriority:1 string arm64" "$plist"
        "$pb" -c "Add :LSArchitecturePriority:2 string x86_64" "$plist"
        "$pb" -c "Add :LSRequiresNativeExecution bool true" "$plist"
    else
        echo "   Intel host detected — leaving default launch architecture."
    fi

    # Refresh LaunchServices so the change takes effect on next launch, even
    # when --update edited the bundle in place.
    local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    if [[ -x "$lsregister" ]]; then
        "$lsregister" -f "$DESKTOP_APP_PATH" 2>/dev/null || true
    fi
}

# Function to install the app
install_app() {
    load_config
    validate_worktree

    # Remove existing app if it exists
    if [[ -d "$DESKTOP_APP_PATH" ]]; then
        echo "📦 Removing existing MaestroDev.app..."
        rm -rf "$DESKTOP_APP_PATH"
    fi

    # Create the app bundle
    echo "📦 Creating MaestroDev.app..."
    mkdir -p "$DESKTOP_APP_PATH/"
    cp -R "$SCRIPT_DIR/Contents" "$DESKTOP_APP_PATH/"
    cp "$SCRIPT_DIR/config.sh" "$DESKTOP_APP_PATH/"

    # Stamp the architecture keys into the freshly-copied Info.plist.
    configure_app_architecture

    echo ""
    echo "✅ Installation complete!"
    echo ""
    echo "   App installed to: $DESKTOP_APP_PATH"
    echo "   Configured for:   $MAESTRO_WORKTREE_DIR"
    echo "   Log file:         ${LOG_FILE:-$MAESTRO_WORKTREE_DIR/MaestroDev.log}"
    echo ""
    echo "🚀 Double-click MaestroDev.app to launch!"
    echo ""
}

# Function to uninstall the app
uninstall_app() {
    load_config

    if [[ ! -d "$DESKTOP_APP_PATH" ]]; then
        echo "ℹ️  MaestroDev.app is not installed at: $DESKTOP_APP_PATH"
        exit 0
    fi

    echo "🗑️  Removing MaestroDev.app from: $DESKTOP_APP_PATH"
    rm -rf "$DESKTOP_APP_PATH"

    echo ""
    echo "✅ Uninstallation complete!"
    echo ""
}

# Function to update the app
update_app() {
    load_config

    if [[ ! -d "$DESKTOP_APP_PATH" ]]; then
        echo "❌ Error: MaestroDev.app is not installed at: $DESKTOP_APP_PATH"
        echo ""
        echo "Run './maestro-launcher --install' first."
        exit 1
    fi

    echo "🔄 Updating MaestroDev.app..."

    # Update Contents directory (scripts and resources)
    echo "   Updating launcher scripts..."
    rm -rf "$DESKTOP_APP_PATH/Contents"
    cp -R "$SCRIPT_DIR/Contents" "$DESKTOP_APP_PATH/"

    # Update config.sh
    echo "   Updating configuration..."
    cp "$SCRIPT_DIR/config.sh" "$DESKTOP_APP_PATH/"

    # Re-stamp the architecture keys — the Contents recopy above replaced the
    # Info.plist with the (key-less) source copy.
    configure_app_architecture

    echo ""
    echo "✅ Update complete!"
    echo ""
    echo "   Updated app at:   $DESKTOP_APP_PATH"
    echo "   Configured for:   $MAESTRO_WORKTREE_DIR"
    echo ""
}

# Main script logic
case "${1:-}" in
    --install)
        install_app
        ;;
    --uninstall)
        uninstall_app
        ;;
    --update)
        update_app
        ;;
    --help|-h|"")
        show_usage
        ;;
    *)
        echo "❌ Unknown option: $1"
        echo ""
        show_usage
        ;;
esac
